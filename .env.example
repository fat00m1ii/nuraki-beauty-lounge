# Copy to `.env` and fill in. NEVER commit the real .env.

# --- Supabase (booking backend) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- ImageKit (image CDN) ---
# URL endpoint, e.g. https://ik.imagekit.io/nuraki  (required to serve images)
VITE_IMAGEKIT_URL_ENDPOINT=

# Only needed to run `npm run upload:imagekit` (auto-upload). Keep private.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# --- Admin bookings view ---
VITE_ADMIN_PASSCODE=nuraki-admin
